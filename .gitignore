# ---------------------------------------------------------------------------
# ai-effect-priming — .gitignore
#
# Deliberately NOT ignored: data/trials_anonymized.csv,
# data/participants_clean.csv, figures/*.png and the notebook outputs.
# Those are committed on purpose, because the README links to the figures and
# the whole point of the repo is that a reader can follow the analysis without
# running anything. Do not add rules for data/ or figures/.
# ---------------------------------------------------------------------------

# --- private data: must never be committed ---------------------------------
# The raw Resultal export and the key that maps visitor_id -> P-code.
# scripts/anonymize_raw_export.py writes the key next to the raw file, which is
# outside the repo, but these patterns are the safety net.
participant_key_PRIVATE.csv
*_PRIVATE*
MasterData*.csv
data/raw/

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- virtual environments --------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- test / type / lint caches --------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- editors and IDEs ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject/
.spyproject/

# --- operating system ------------------------------------------------------
.DS_Store
._*
.DS_Store?
Thumbs.db
desktop.ini

# --- misc ------------------------------------------------------------------
*.log
